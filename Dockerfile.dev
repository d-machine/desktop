FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies for Tauri on Linux
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    libssl-dev \
    pkg-config \
    # Tauri / WebKit dependencies
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    # For running the Vite dev server
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:$PATH"

# Install Tauri CLI
RUN cargo install tauri-cli --version "^2"

WORKDIR /app

# Install npm dependencies (runs once — cached unless package.json changes)
COPY package.json package-lock.json* ./
RUN npm ci

# Source code is mounted as a volume — not copied
# This lets you edit files on your host and see changes instantly

EXPOSE 1420

CMD ["npm", "run", "tauri", "dev"]
