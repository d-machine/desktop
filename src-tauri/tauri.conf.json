{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArthaDesk",
  "version": "0.1.0",
  "identifier": "com.arthaDesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArthaDesk",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pdftotext"
    ],
    "resources": {
      "binaries/libgcc_s_seh-1.dll":   "libgcc_s_seh-1.dll",
      "binaries/libstdc++-6.dll":      "libstdc++-6.dll",
      "binaries/libwinpthread-1.dll":  "libwinpthread-1.dll",
      "backend/**/*":                  "backend/"
    }
  }
}
